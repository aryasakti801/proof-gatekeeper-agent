PORT=8787
# 32-byte HMAC secret from Dashboard → Rotate Secret. Never commit the real value.
# Accepts 64-char hex, 0x-prefixed hex, or the exact plaintext the dashboard shows.
AGENT_GAMES_HMAC_SECRET=

# Optional private salt for the Groth16 commitment output. Default 0.
AGENT_GAMES_SALT=0

# Persistent seen-set for proof_tx reuse detection.
SEEN_PATH=./data/seen.json

# Optional. If set, the agent may look up incoming proof_tx finality on Kurier.
# Leave blank for field-only checks (still sufficient for the six documented field traps).
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
